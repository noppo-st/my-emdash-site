---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

// Limit to what we render (1 featured + 6 grid). The DB does the slicing
// instead of fetching every post and discarding the tail in JS.
const POSTS_PER_PAGE = 7;

const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: POSTS_PER_PAGE + 1, // +1 to detect "view all" need
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Trim the lookahead post used to detect overflow
const visiblePosts = posts.slice(0, POSTS_PER_PAGE);
const hasMorePosts = posts.length > POSTS_PER_PAGE;

// Find the first post with a featured image for the hero
const featuredPost = visiblePosts.find((p) => p.data.featured_image);
const featuredIndex = featuredPost ? visiblePosts.indexOf(featuredPost) : -1;

// Get remaining posts (exclude featured if found, limit to 6 for grid)
const gridPosts = visiblePosts
	.filter((_, i) => i !== featuredIndex)
	.slice(0, 6);

// Single batched query for tags across the featured post + grid posts.
// Avoids the N+1 pattern of calling getEntryTerms() per entry.
// Bylines are already hydrated on entry.data.bylines by getEmDashCollection.
const tagEntryIds = [
	...(featuredPost ? [featuredPost.data.id] : []),
	...gridPosts.map((p) => p.data.id),
];
const tagsByEntry = await getTermsForEntries("posts", tagEntryIds, "tag");

const featuredTags = featuredPost
	? (tagsByEntry.get(featuredPost.data.id) ?? []).map((t) => ({
			slug: t.slug,
			label: t.label,
		}))
	: [];

const gridPostsWithTags = gridPosts.map((post) => ({
	post,
	tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
}));
---

<Base title={siteTitle} description={siteTagline}>
	{/* 自然物の飾り用シンボル（緑の葉の小枝） */}
	<svg width="0" height="0" style="position:absolute" aria-hidden="true">
		<defs>
			<symbol id="eco-sprig" viewBox="0 0 150 92">
				<g fill="currentColor" stroke="#4a5836" stroke-width="2">
					<path
						d="M8 86 C52 76 104 46 144 10"
						fill="none"
						stroke-width="5"
						stroke-linecap="round"></path>
					<g stroke="none">
						<ellipse cx="40" cy="58" rx="15" ry="7.5" transform="rotate(-34 40 58)"
						></ellipse>
						<ellipse cx="74" cy="40" rx="15" ry="7.5" transform="rotate(-34 74 40)"
						></ellipse>
						<ellipse cx="106" cy="24" rx="13" ry="6.8" transform="rotate(-34 106 24)"
						></ellipse>
						<ellipse cx="56" cy="68" rx="12" ry="6" transform="rotate(26 56 68)"
						></ellipse>
					</g>
					<path
						d="M33 64 L47 52 M67 46 L81 34 M100 30 L112 19"
						fill="none"
						stroke="#4a5836"
						stroke-width="1.4"></path>
				</g>
			</symbol>
		</defs>
	</svg>

	<header class="band intro">
		<div class="frame hero">
			<div class="title-plate">
				<svg class="deco deco--sprig-l" viewBox="0 0 150 92" aria-hidden="true"
					><use href="#eco-sprig"></use></svg
				>
				<svg class="deco deco--sprig-r" viewBox="0 0 150 92" aria-hidden="true"
					><use href="#eco-sprig"></use></svg
				>
				<img class="deco deco--acorn" src="/nature/donguri.png" alt="" aria-hidden="true" />
				<img class="deco deco--pine" src="/nature/matsubokkuri.png" alt="" aria-hidden="true" />
				<h1 class="title-plate__title">{siteTitle}</h1>
				{siteTagline && <p class="title-plate__sub">{siteTagline}</p>}
			</div>
			<a
				href="/rss.xml"
				type="application/rss+xml"
				class="btn btn--ghost btn--sm"
			>
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M4 11a9 9 0 0 1 9 9"></path>
					<path d="M4 4a16 16 0 0 1 16 16"></path>
					<circle cx="5" cy="19" r="1"></circle>
				</svg>
				RSS feed
			</a>
		</div>
	</header>

	{
		posts.length === 0 ? (
			<section class="band section">
				<div class="frame">
					<div class="empty-state">
						<h2 class="empty-state__title">No posts yet</h2>
						<p class="empty-state__text">
							Create your first post in the admin panel.
						</p>
						<div class="empty-state__actions">
							<a href="/_emdash/admin/content/posts/new" class="btn">
								Create a post
							</a>
						</div>
					</div>
				</div>
			</section>
		) : (
			<>
				{featuredPost && (
					<section class="band section">
						<div class="frame">
							<PostCard
								post={featuredPost}
								tags={featuredTags}
								variant="feature"
								headingLevel={2}
								priority
							/>
						</div>
					</section>
				)}

				{gridPostsWithTags.length > 0 && (
					<section class="band section" aria-labelledby="latest-posts">
						<div class="frame">
							<div class="section-head">
								<h2 id="latest-posts" class="section-head__title">
									Latest posts
								</h2>
								{hasMorePosts && (
									<a href="/posts" class="arrow-link">
										View all<span class="sr-only"> posts</span>
										<svg
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.75"
											stroke-linecap="round"
											stroke-linejoin="round"
											aria-hidden="true"
										>
											<path d="M5 12h14" />
											<path d="m12 5 7 7-7 7" />
										</svg>
									</a>
								)}
							</div>
							<div class="post-grid">
								{gridPostsWithTags.map(({ post, tags }) => (
									<PostCard
										post={post}
										tags={tags}
										variant="card"
										headingLevel={3}
									/>
								))}
							</div>
						</div>
					</section>
				)}
			</>
		)
	}
</Base>

<style>
	/* ヒーロー：木のフレームに入れたタイトルを中央に */
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-6);
	}

	/* 木（丸太）フレームの看板 */
	.title-plate {
		position: relative;
		text-align: center;
		padding: clamp(1.4rem, 1rem + 3vw, 2.6rem) clamp(2rem, 1.2rem + 6vw, 4.5rem);
		border-radius: 30px;
		background:
			repeating-linear-gradient(
				90deg,
				color-mix(in srgb, var(--wood-panel) 100%, transparent) 0 14px,
				color-mix(in srgb, var(--wood-panel) 92%, #000) 14px 15px
			),
			var(--wood-panel);
		box-shadow:
			0 0 0 7px var(--wood-light),
			0 0 0 13px var(--wood-mid),
			0 0 0 20px var(--wood-dark),
			0 14px 30px -10px rgba(60, 48, 20, 0.35);
	}

	/* 丸太の継ぎ目を上下の縁に薄く入れる */
	.title-plate::after {
		content: "";
		position: absolute;
		inset: -20px;
		border-radius: 42px;
		background: repeating-linear-gradient(
			90deg,
			transparent 0 46px,
			rgba(90, 54, 20, 0.28) 46px 48px
		);
		-webkit-mask:
			linear-gradient(#000 0 0) top / 100% 20px no-repeat,
			linear-gradient(#000 0 0) bottom / 100% 20px no-repeat;
		mask:
			linear-gradient(#000 0 0) top / 100% 20px no-repeat,
			linear-gradient(#000 0 0) bottom / 100% 20px no-repeat;
		pointer-events: none;
	}

	.title-plate__title {
		position: relative;
		z-index: 1;
		font-size: var(--font-size-display);
		line-height: 1.22;
		color: var(--wood-title);
	}

	.title-plate__sub {
		position: relative;
		z-index: 1;
		margin-top: var(--spacing-2);
		font-family: var(--font-heading);
		font-size: calc(var(--font-size-display) * 0.52);
		color: var(--wood-sub);
	}

	/* 自然物の飾り（タイトルを囲む） */
	.deco {
		position: absolute;
		pointer-events: none;
		z-index: 2;
	}

	.deco--sprig-l {
		top: -30px;
		inset-inline-start: -16px;
		width: clamp(80px, 12vw, 128px);
		height: auto;
		color: var(--color-brand);
	}

	.deco--sprig-r {
		top: -30px;
		inset-inline-end: -16px;
		width: clamp(80px, 12vw, 128px);
		height: auto;
		color: var(--color-brand);
		transform: scaleX(-1);
	}

	.deco--acorn {
		bottom: -24px;
		inset-inline-start: -18px;
		width: clamp(44px, 6vw, 64px);
		transform: rotate(-14deg);
		filter: drop-shadow(0 4px 6px rgba(60, 48, 20, 0.2));
	}

	.deco--pine {
		bottom: -26px;
		inset-inline-end: -18px;
		width: clamp(46px, 6vw, 66px);
		transform: rotate(14deg);
		filter: drop-shadow(0 4px 6px rgba(60, 48, 20, 0.2));
	}

	/* タイトルが短い端末では飾りを少し内側に寄せる */
	@media (max-width: 480px) {
		.deco--sprig-l,
		.deco--sprig-r {
			width: 72px;
		}
	}
</style>
